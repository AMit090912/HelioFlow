# Copy to backend/.env and fill in values. Never commit backend/.env.
ENV=development
DATABASE_URL=postgresql+psycopg://helio:helio@localhost:5433/helio
TEST_DATABASE_URL=postgresql+psycopg://helio:helio@localhost:5433/helio_test
JWT_SECRET=
JWT_TTL_HOURS=8
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
# live = real Groq → Gemini; demo = labelled fixtures for the synthetic sample bills only
AI_MODE=live
GROQ_API_KEY=
# Leave model names blank to use the defaults: qwen/qwen3.8-27b, openai/gpt-oss-120b, gemini-3.5-flash
GROQ_VISION_MODEL=
GROQ_TEXT_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_SECONDS=20
MAX_UPLOAD_MB=10
SEED_DEMO_PASSWORD=

# One-click demo sign-in on the sign-in page (new homeowner, demo homeowner, sales, admin).
# Off unless set to true (e.g. on a deployed demo, so reviewers can try every role).
DEMO_LOGINS=
